# Erchis game client — copy to .env. Never commit .env itself.

# Base URL the browser calls for the API.
#
# Deliberately EMPTY for local development: the app requests a relative `/api`,
# and craco.config.js proxies that to http://localhost:8000. Same-origin, so no
# CORS preflight and the auth cookie behaves normally.
#
# Set it to a full origin (e.g. https://api.erchis.online) only when the API is
# served from a different host than the client.
REACT_APP_BACKEND_URL=
