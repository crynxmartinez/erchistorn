# Erchis backend — copy to .env and fill in. Never commit .env itself.

# MongoDB connection string. Local dev uses a plain localhost instance;
# production uses the Atlas SRV URI.
MONGO_URL=mongodb://localhost:27017

# Database name. Keep dev, test and production on separate names — the schema
# migrations run against whatever this points at on boot.
DB_NAME=erchis_local

# Signing key for the auth JWT. Generate a long random value per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this logs every player out.
JWT_SECRET=replace-me-with-a-long-random-string

# Send the auth cookie only over HTTPS. false for local http, true in production.
COOKIE_SECURE=false

# Allowed CORS origin(s) for the browser client, comma-separated.
FRONTEND_URL=http://localhost:3000
